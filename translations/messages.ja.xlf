    <body>
      <trans-unit id="1">
        <source>Packages</source>
        <target>パッケージ</target>
      </trans-unit>
      <trans-unit id="2">
        <source>Composer: Show Outdated Packages</source>
        <target>Composer: 古いパッケージを表示</target>
      </trans-unit>
      <trans-unit id="3">
        <source>Composer: Install</source>
        <target>Composer: インストール</target>
      </trans-unit>
      <trans-unit id="4">
        <source>Composer: Update All</source>
        <target>Composer: すべて更新</target>
      </trans-unit>
      <trans-unit id="5">
        <source>Composer: Update Package at Caret</source>
        <target>Composer: カーソル位置のパッケージを更新</target>
      </trans-unit>
      <trans-unit id="6">
        <source>Composer: Require Package…</source>
        <target>Composer: パッケージを追加…</target>
      </trans-unit>
      <trans-unit id="7">
        <source>Composer: Remove Package at Caret</source>
        <target>Composer: カーソル位置のパッケージを削除</target>
      </trans-unit>
      <trans-unit id="8">
        <source>Require (vendor/name[:constraint], --dev for a dev dependency)</source>
        <target>追加 (vendor/name[:制約]、開発用の依存は --dev)</target>
      </trans-unit>
      <trans-unit id="9">
        <source>composer outdated exited with code %code%</source>
        <target>composer outdated がコード %code% で終了しました</target>
      </trans-unit>
      <trans-unit id="10">
        <source>composer could not be started</source>
        <target>composer を起動できませんでした</target>
      </trans-unit>
      <trans-unit id="11">
        <source>Every direct dependency is on its latest release</source>
        <target>すべての直接依存が最新リリースです</target>
      </trans-unit>
      <trans-unit id="12">
        <source>%count% direct dependency has a newer release|%count% direct dependencies have newer releases</source>
        <target>%count% 個の直接依存に新しいリリースがあります</target>
      </trans-unit>
      <trans-unit id="13">
        <source>(past the constraint)</source>
        <target>(制約の範囲外)</target>
      </trans-unit>
      <trans-unit id="14">
        <source>abandoned</source>
        <target>放棄済み</target>
      </trans-unit>
      <trans-unit id="15">
        <source>abandoned, use %package%</source>
        <target>放棄済み、%package% を使用</target>
      </trans-unit>
      <trans-unit id="16">
        <source>%command% finished</source>
        <target>%command% が完了しました</target>
      </trans-unit>
      <trans-unit id="17">
        <source>%command% was stopped before it finished</source>
        <target>%command% は完了前に停止されました</target>
      </trans-unit>
      <trans-unit id="18">
        <source>%command% exited with code %code% — see its terminal tab</source>
        <target>%command% がコード %code% で終了しました — ターミナルタブを参照</target>
      </trans-unit>
      <trans-unit id="19">
        <source>Put the caret on a package in composer.json's require or require-dev</source>
        <target>composer.json の require か require-dev のパッケージにカーソルを置いてください</target>
      </trans-unit>
