  <file source-language="en" target-language="he" datatype="plaintext" original="messages">
    <body>
      <trans-unit id="1">
        <source>Packages</source>
        <target>חבילות</target>
      </trans-unit>
      <trans-unit id="2">
        <source>Composer: Show Outdated Packages</source>
        <target>Composer: הצגת חבילות מיושנות</target>
      </trans-unit>
      <trans-unit id="3">
        <source>Composer: Install</source>
        <target>Composer: התקנה</target>
      </trans-unit>
      <trans-unit id="4">
        <source>Composer: Update All</source>
        <target>Composer: עדכון הכול</target>
      </trans-unit>
      <trans-unit id="5">
        <source>Composer: Update Package at Caret</source>
        <target>Composer: עדכון החבילה שבסמן</target>
      </trans-unit>
      <trans-unit id="6">
        <source>Composer: Require Package…</source>
        <target>Composer: הוספת חבילה…</target>
      </trans-unit>
      <trans-unit id="7">
        <source>Composer: Remove Package at Caret</source>
        <target>Composer: הסרת החבילה שבסמן</target>
      </trans-unit>
      <trans-unit id="8">
        <source>Require (vendor/name[:constraint], --dev for a dev dependency)</source>
        <target>הוספה (vendor/name[:אילוץ], ‏--dev לתלות פיתוח)</target>
      </trans-unit>
      <trans-unit id="9">
        <source>composer outdated exited with code %code%</source>
        <target>composer outdated הסתיים עם קוד %code%</target>
      </trans-unit>
      <trans-unit id="10">
        <source>composer could not be started</source>
        <target>לא ניתן היה להפעיל את composer</target>
      </trans-unit>
      <trans-unit id="11">
        <source>Every direct dependency is on its latest release</source>
        <target>כל תלות ישירה נמצאת בגרסה האחרונה שלה</target>
      </trans-unit>
      <trans-unit id="12">
        <source>%count% direct dependency has a newer release|%count% direct dependencies have newer releases</source>
        <target>לתלות ישירה %count% יש גרסה חדשה יותר|ל־%count% תלויות ישירות יש גרסאות חדשות יותר</target>
      </trans-unit>
      <trans-unit id="13">
        <source>(past the constraint)</source>
        <target>(מעבר לאילוץ)</target>
      </trans-unit>
      <trans-unit id="14">
        <source>abandoned</source>
        <target>נזנחה</target>
      </trans-unit>
      <trans-unit id="15">
        <source>abandoned, use %package%</source>
        <target>נזנחה, השתמשו ב־%package%</target>
      </trans-unit>
      <trans-unit id="16">
        <source>%command% finished</source>
        <target>%command% הסתיים</target>
      </trans-unit>
      <trans-unit id="17">
        <source>%command% was stopped before it finished</source>
        <target>%command% נעצר לפני שהסתיים</target>
      </trans-unit>
      <trans-unit id="18">
        <source>%command% exited with code %code% — see its terminal tab</source>
        <target>%command% הסתיים עם קוד %code% — ראו את לשונית המסוף שלו</target>
      </trans-unit>
      <trans-unit id="19">
        <source>Put the caret on a package in composer.json's require or require-dev</source>
        <target>הציבו את הסמן על חבילה ב־require או ב־require-dev של composer.json</target>
      </trans-unit>
